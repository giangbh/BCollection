# Documentation only: the application does not auto-load .env files.
BCOLLECTION_MODE=demo
# Optional for demo/test. Required and separate for integration.
# BCOLLECTION_DB_PATH=/absolute/path/to/demo.sqlite3
CORE_BANKING_MODE=mock
LOS_MODE=mock
CIC_MODE=mock
MESSAGING_MODE=mock
# Integration: set the first three adapter modes to http and explicit URLs.
# CORE_BANKING_API_URL=https://approved-esb.example/core/v1
# LOS_API_URL=https://approved-esb.example/los/v1
# CIC_GATEWAY_URL=https://approved-esb.example/cic/v1
# Supply credentials through the approved secret mechanism, never Git:
# CORE_BANKING_API_KEY, LOS_API_KEY, CIC_GATEWAY_KEY
