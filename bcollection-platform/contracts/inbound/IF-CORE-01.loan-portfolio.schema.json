{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IF_CORE_01_LoanPortfolioSchema",
  "type": "object",
  "required": [
    "batch_date",
    "loan_id",
    "debtor_cif",
    "product_code",
    "dpd",
    "outstanding_principal",
    "outstanding_interest",
    "overdue_amount",
    "loan_status"
  ],
  "properties": {
    "batch_date": { "type": "string", "format": "date" },
    "loan_id": { "type": "string" },
    "debtor_cif": { "type": "string" },
    "product_code": { "type": "string" },
    "dpd": { "type": "integer", "minimum": 0 },
    "outstanding_principal": { "type": "number", "minimum": 0 },
    "outstanding_interest": { "type": "number", "minimum": 0 },
    "overdue_amount": { "type": "number", "minimum": 0 },
    "loan_status": { "type": "string", "enum": ["ACTIVE", "OVERDUE", "SETTLED", "WRITTEN_OFF"] }
  }
}
